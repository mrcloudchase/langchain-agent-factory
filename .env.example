# Model provider (one is enough). Without any key the factory runs in offline mode
# with scripted trajectories so the pipeline, policy checks, and eval gate still run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith: tracing, evaluation uploads, Context Hub, feedback loop.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-factory

# Force offline mode even when keys are present.
FACTORY_OFFLINE=0

# Surfaces. The deployment URL is used by the Slack bot and cron registration;
# the webhook app runs inside the Agent Server and addresses itself.
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
HELPDESK_WEBHOOK_SECRET=change-me
