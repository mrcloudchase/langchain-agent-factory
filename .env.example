# Model provider for the tiers in org/models.yaml (DeepSeek by default). Without a key the
# factory runs offline: templates ship scripted trajectories so policy, build, gates, and
# promotion all run with no secrets.
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# LangSmith: tracing, experiments, Context Hub, trace harvest.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-factory

FACTORY_OFFLINE=0
LANGGRAPH_DEPLOYMENT_URL=http://localhost:2024
FACTORY_WEBHOOK_SECRET=change-me
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
