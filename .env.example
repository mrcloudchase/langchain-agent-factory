# Model provider for org/models.yaml (DeepSeek by default). With no provider key the factory
# runs offline: scripted trajectories and recorded HTTP fixtures, so everything works in CI.
DEEPSEEK_API_KEY=

# LangSmith: traces, eval experiments, Context Hub versions, feedback.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=agent-factory

# Force offline mode even when keys are present.
FACTORY_OFFLINE=0

# Shared secret external systems send to /webhooks/<agent>.
FACTORY_WEBHOOK_SECRET=change-me
