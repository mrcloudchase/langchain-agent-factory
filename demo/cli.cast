[0.020367, "o", "\u001b[H\u001b[2J\u001b[3J"]
[0.022808, "o", "\u001b[1mAgent Factory\u001b[0m  -  the organization defines agents and the path to production; teams create from templates\r\nmode: \u001b[1;33moffline (scripted replay, no keys)\u001b[0m\r\n"]
[3.023397, "o", "\r\n\u001b[1;36m# 1. What the organization owns: templates, a published tool catalog, processes\u001b[0m\r\n"]
[4.326482, "o", "\u001b[1;32m$ factory templates\u001b[0m\r\n"]
[5.303582, "o", "┏━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mkey                  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1marchetype\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mteam       \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mprocess  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mpauses for human     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1msummary             \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━┩\r\n│ claims_processing     │ workflow  │ operations  │ regulated │ record_claim_decision │ Takes a claim,       │\r\n│                       │           │             │           │                       │ checks the claims    │\r\n│                       │           │             │           │                       │ policy, decides      │\r\n│                       │           │             │           │                       │ approve, deny, or    │\r\n│                       │           │             │           │                       │ refer, and records   │\r\n│                       │           │             │           │                       │ the decision.        │\r\n│                       │           │             │           │                       │ Recording always     │\r\n│                       │           │             │           │                       │ pauses for a human;  │\r\n│                       │           │             │           │                       │ the process requires │\r\n│                       │           │             │           │                       │ two approvals to     │\r\n│                       │           │             │           │                       │ reach production.    │\r\n│ document_review       │ workflow  │ legal       │ standard  │ -                     │ Reads a pasted       │\r\n│                       │           │             │           │                       │ contract or policy,  │\r\n│                       │           │             │           │                       │ extracts the         │\r\n│                       │           │             │           │                       │ clauses, checks each │\r\n│                       │           │             │           │                       │ against the house    │\r\n│                       │           │             │           │                       │ rules, and reports   │\r\n│                       │           │             │           │                       │ risks. No side       │\r\n│                       │           │             │           │                       │ effects.             │\r\n│ engineering_assistant │ agent     │ engineering │ standard  │ post_pr_comment       │ Lives in the IDE     │\r\n│                       │           │             │           │                       │ over MCP: explains   │\r\n│                       │           │             │           │                       │ code, diagnoses CI   │\r\n│                       │           │             │           │                       │ failures from the    │\r\n│                       │           │             │           │                       │ failing test and     │\r\n│                       │           │             │           │                       │ diff, posts review   │\r\n│        "]
[5.303981, "o", "               │           │             │           │                       │ comments after       │\r\n│                       │           │             │           │                       │ approval.            │\r\n│ judge                 │ agent     │ platform    │ standard  │ -                     │ Grades an answer     │\r\n│                       │           │             │           │                       │ against a reference  │\r\n│                       │           │             │           │                       │ or rubric and        │\r\n│                       │           │             │           │                       │ returns a 0-1 score  │\r\n│                       │           │             │           │                       │ with reasons. Usable │\r\n│                       │           │             │           │                       │ as an LLM judge in   │\r\n│                       │           │             │           │                       │ the eval gate.       │\r\n│ meeting_actions       │ agent     │ platform    │ standard  │ -                     │ Turns pasted meeting │\r\n│                       │           │             │           │                       │ notes into owners,   │\r\n│                       │           │             │           │                       │ actions, and dates.  │\r\n│                       │           │             │           │                       │ No tools; the        │\r\n│                       │           │             │           │                       │ smallest useful      │\r\n│                       │           │             │           │                       │ agent and a good     │\r\n│                       │           │             │           │                       │ first self-service   │\r\n│                       │           │             │           │                       │ example.             │\r\n│ research_brief        │ agent     │ research    │ standard  │ -                     │ Sourced answers to   │\r\n│                       │           │             │           │                       │ research questions,  │\r\n│                       │           │             │           │                       │ knowledge base first │\r\n│                       │           │             │           │                       │ then the web, and a  │\r\n│                       │           │             │           │                       │ scheduled digest     │\r\n│                       │           │             │           │                       │ posted to Slack.     │\r\n│ support_triage        │ agent     │ support     │ standard  │ issue_refund          │ Triages helpdesk     │\r\n│                       │           │             │           │                       │ tickets: gathers     │\r\n│                       │           │             │           │                       │ context, applies the │\r\n│                       │           │             │           │                       │ refund and           │\r\n│                       │           │             │           │                       │ escalation policies, │\r\n│                       │           │             │           │                       │ drafts a reply for a │\r\n│                       │           │             │           │                       │ human, and pauses    │\r\n│                       │           │             │           │                       │ before any refund.   │\r\n└───────────────────────┴───────────┴─────────────┴───────────┴───"]
[5.304151, "o", "────────────────────┴──────────────────────┘\r\n"]
[7.551494, "o", "\u001b[1;32m$ factory tools\u001b[0m\r\n"]
[8.510857, "o", "┏━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mtool                 \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mrisk  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mscope  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1msensitive\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mteams                \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mowner      \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━┩\r\n│ knowledge_search      │ low    │ any     │           │ all                   │ platform    │\r\n│ web_search            │ low    │ any     │           │ all                   │ platform    │\r\n│ lookup_ticket         │ low    │ any     │           │ support               │ support     │\r\n│ lookup_customer       │ medium │ any     │           │ support               │ support     │\r\n│ lookup_order          │ low    │ any     │           │ support               │ support     │\r\n│ draft_reply           │ low    │ any     │           │ support               │ support     │\r\n│ escalate_ticket       │ medium │ any     │           │ support               │ support     │\r\n│ issue_refund          │ high   │ any     │ yes       │ support               │ support     │\r\n│ read_repo_file        │ low    │ any     │           │ engineering, platform │ engineering │\r\n│ search_code           │ low    │ any     │           │ engineering, platform │ engineering │\r\n│ read_ci_status        │ low    │ any     │           │ engineering, platform │ engineering │\r\n│ post_pr_comment       │ medium │ user    │ yes       │ engineering           │ engineering │\r\n│ send_slack_message    │ medium │ service │           │ research, platform    │ platform    │\r\n│ record_claim_decision │ high   │ any     │ yes       │ operations            │ operations  │\r\n└───────────────────────┴────────┴─────────┴───────────┴───────────────────────┴─────────────┘\r\n"]
[10.756866, "o", "\r\n\u001b[1;36m# 2. A team creates an agent from a template. Policy runs before anything is kept.\u001b[0m\r\n"]
[12.060166, "o", "\u001b[1;32m$ factory new claims_demo --template claims_processing --owner ops-analyst@halcyon.example --display Claims Demo\u001b[0m\r\n"]
[13.056479, "o", "\u001b[32mCreated \u001b[0m\u001b[32m/home/user/langchain-agent-factory/agents/\u001b[0m\u001b[32mclaims_demo\u001b[0m \u001b[1m(\u001b[0mworkflow from \u001b[32m'claims_processing'\u001b[0m, process \r\n\u001b[32m'regulated'\u001b[0m\u001b[1m)\u001b[0m\r\n"]
[15.303492, "o", "\r\n\u001b[1;36m#    The wrong team is refused with the rule\u001b[0m\r\n"]
[16.608474, "o", "\u001b[1;32m$ factory new claims_for_research --template claims_processing --team research --owner research-lead@halcyon.example\u001b[0m\r\n"]
[17.628887, "o", "\u001b[31mNot created: policy violations\u001b[0m\r\n"]
[17.629552, "o", "  template.allowed: template \u001b[32m'claims_processing'\u001b[0m is not available to team \u001b[32m'research'\u001b[0m\r\n"]
[17.630053, "o", "  tool.allowed: team \u001b[32m'research'\u001b[0m may not use tool \u001b[32m'record_claim_decision'\u001b[0m\r\n"]
[17.630438, "o", "  tool.allowed: team \u001b[32m'research'\u001b[0m may not use tool \u001b[32m'record_claim_decision'\u001b[0m\r\n"]
[19.889238, "o", "\r\n\u001b[1;36m# 3. Run it: a workflow with four steps; recording the decision pauses for a human\u001b[0m\r\n"]
[21.192476, "o", "\u001b[1;32m$ factory run claims_demo Claim: policy P-1007, stolen laptop from a locked car on 2026-09-28, amount $3,100, police report attached. --approve\u001b[0m\r\n"]
[22.62384, "o", "\u001b[33moffline mode: replaying scripted trajectories\u001b[0m\r\n"]
[22.932582, "o", "\u001b[33mApproval required:\u001b[0m \u001b[1;35mrecord_claim_decision\u001b[0m\u001b[1m(\u001b[0m\u001b[1m{\u001b[0m\u001b[32m\"policy_number\"\u001b[0m: \u001b[32m\"P-1007\"\u001b[0m, \u001b[32m\"decision\"\u001b[0m: \u001b[32m\"refer\"\u001b[0m, \u001b[32m\"amount_usd\"\u001b[0m: \u001b[1;36m3100\u001b[0m, \r\n\u001b[32m\"reason\"\u001b[0m: \u001b[32m\"Covered theft above the auto-approval limit.\"\u001b[0m\u001b[1m}\u001b[0m\u001b[1m)\u001b[0m\r\n"]
[22.958725, "o", "\u001b[2mtool knowledge_search: \u001b[0m\r\n\u001b[2m## Auto-approval limit\u001b[0m\r\n\u001b[2mClaims up to $\u001b[0m\u001b[1;2;36m2\u001b[0m\u001b[2m,\u001b[0m\u001b[1;2;36m500\u001b[0m\u001b[2m with complete documentation may be approved by the agent. Claims above $\u001b[0m\u001b[1;2;36m2\u001b[0m\u001b[2m,\u001b[0m\u001b[1;2;36m500\u001b[0m\u001b[2m are referred\u001b[0m\r\n\u001b[2mto an a\u001b[0m\r\n"]
[22.959388, "o", "\u001b[2mtool record_claim_decision: Recorded: policy P-\u001b[0m\u001b[1;2;36m1007\u001b[0m\u001b[2m -> refer for $\u001b[0m\u001b[1;2;36m3\u001b[0m\u001b[2m,\u001b[0m\u001b[1;2;36m100.00\u001b[0m\u001b[2m. Reason: Covered theft above the \u001b[0m\r\n\u001b[2mauto-approval limit. Reference CL-\u001b[0m\u001b[1;2;36m1007\u001b[0m\u001b[2m.\u001b[0m\r\n"]
[22.960324, "o", "\u001b[36mintake\u001b[0m: policy_number: P-\u001b[1;36m1007\u001b[0m\r\nincident_type: theft from locked vehicle\r\nincident_date: \u001b[1;36m2026\u001b[0m-\u001b[1;36m09\u001b[0m-\u001b[1;36m28\u001b[0m\r\namount_usd: \u001b[1;36m3100\u001b[0m\r\ndocumentation: police report\r\nmissing: none\r\n"]
[22.961156, "o", "\u001b[36massess\u001b[0m: decision: refer\r\nreason: Theft with a police report is covered, but $\u001b[1;36m3\u001b[0m,\u001b[1;36m100\u001b[0m exceeds the $\u001b[1;36m2\u001b[0m,\u001b[1;36m500\u001b[0m auto-approval limit, so an \r\nadjuster signs off.\r\n"]
[22.961325, "o", "\u001b[36mrecord\u001b[0m: recorded\r\n"]
[22.962257, "o", "\u001b[36msummary\u001b[0m: Claim: P-\u001b[1;36m1007\u001b[0m, theft from a locked vehicle, $\u001b[1;36m3\u001b[0m,\u001b[1;36m100\u001b[0m.\r\nDecision: refer to an adjuster.\r\nPolicy clause: theft with a police report is covered; amount exceeds the $\u001b[1;36m2\u001b[0m,\u001b[1;36m500\u001b[0m auto-approval limit.\r\nHuman: confirm \r\n"]
[22.963096, "o", "\r\nClaim: P-\u001b[1;36m1007\u001b[0m, theft from a locked vehicle, $\u001b[1;36m3\u001b[0m,\u001b[1;36m100\u001b[0m.\r\nDecision: refer to an adjuster.\r\nPolicy clause: theft with a police report is covered; amount exceeds the $\u001b[1;36m2\u001b[0m,\u001b[1;36m500\u001b[0m auto-approval limit.\r\nHuman: confirm the referral and assign an adjuster.\r\n"]
[25.557636, "o", "\r\n\u001b[1;36m# 4. The gate: evaluators, thresholds, regression checks\u001b[0m\r\n"]
[26.860239, "o", "\u001b[1;32m$ factory eval claims_demo\u001b[0m\r\n"]
[29.184307, "o", "\u001b[3m             claims_demo · offline · 4 examples             \u001b[0m\r\n┏━━━━━━━━━━━━━━━━━━━┳━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mevaluator        \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mmean\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mthreshold\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mbaseline\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mresult\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━━╇━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━┩\r\n│ answer_contains   │ 1.00 │ 0.80      │ -        │ \u001b[32mpass\u001b[0m   │\r\n│ oversight         │ 1.00 │ 1.00      │ -        │ \u001b[32mpass\u001b[0m   │\r\n│ policy_compliance │ 1.00 │ 1.00      │ -        │ \u001b[32mpass\u001b[0m   │\r\n│ tool_usage        │ 1.00 │ 0.90      │ -        │ \u001b[32mpass\u001b[0m   │\r\n└───────────────────┴──────┴───────────┴──────────┴────────┘\r\n"]
[31.768141, "o", "\r\n\u001b[1;36m# 5. Promotion follows the process: dev -> staging on policy and evals\u001b[0m\r\n"]
[33.070733, "o", "\u001b[1;32m$ factory promote claims_demo --by ops-analyst@halcyon.example\u001b[0m\r\n"]
[35.362388, "o", "\u001b[32mclaims_demo -> staging: promoted\u001b[0m\r\n"]
[35.362676, "o", "  - LANGSMITH_API_KEY not set: context not pushed to Context Hub\r\n"]
[37.999006, "o", "\r\n\u001b[1;36m#    staging -> production needs an ops approver and a platform approver\u001b[0m\r\n"]
[40.7844, "o", "claims_demo -> production: pending\r\n"]
[40.784879, "o", "  - automatic gates passed; waiting on an approver on team 'operations', a platform approver\r\n"]
[40.785385, "o", "  request id: 3970d50385  (approve with: factory approve claims_demo 3970d50385 --as <user>)\r\n"]
[43.19489, "o", "\r\n\u001b[1;36m#    A builder cannot approve; the ops lead and the platform lead can\u001b[0m\r\n"]
[44.497659, "o", "\u001b[1;32m$ factory approve claims_demo 3970d50385 --as ops-analyst@halcyon.example\u001b[0m\r\n"]
[46.236655, "o", "\u001b[31mops-analyst@halcyon.example cannot approve any open gate on this request\u001b[0m\r\n"]
[48.760861, "o", "\u001b[1;32m$ factory approve claims_demo 3970d50385 --as ops-lead@halcyon.example\u001b[0m\r\n"]
[50.564383, "o", "claims_demo -> production: pending\r\n"]
[50.56473, "o", "  - approval approved by ops-lead@halcyon.example; still waiting on platform_approval\r\n"]
[53.078904, "o", "\u001b[1;32m$ factory approve claims_demo 3970d50385 --as platform-lead@halcyon.example\u001b[0m\r\n"]
[54.78716, "o", "claims_demo -> production: promoted\r\n"]
[54.787241, "o", "  - baseline saved from the gate run that opened this request\r\n"]
[54.787556, "o", "  - LANGSMITH_API_KEY not set: context not pushed to Context Hub\r\n"]
