[86.65422, "o", "\r\n\u001b[1;36m# 6. Surfaces: the same endpoint, different doors\u001b[0m\r\n"]
[87.856378, "o", "\u001b[1;32m$ factory surfaces show engineering_assistant\u001b[0m\r\n"]
[89.415273, "o", "\u001b[1mEngineering Assistant\u001b[0m \u001b[1m(\u001b[0mengineering_assistant\u001b[1m)\u001b[0m · identity: user \u001b[1m(\u001b[0mattended\u001b[1m)\u001b[0m\r\n"]
[89.415622, "o", "  mcp      -> \u001b[4;94mhttp://localhost:2024/mcp\u001b[0m exposes tool \u001b[32m'engineering_assistant'\u001b[0m \u001b[1m(\u001b[0mStreamable HTTP\u001b[1m)\u001b[0m. Claude Code: \r\n`claude mcp add --transport http engineering_assistant \u001b[4;94mhttp://localhost:2024/mcp`\u001b[0m\r\n"]
[89.415969, "o", "  chat     -> any LangGraph-compatible chat UI \u001b[1m(\u001b[0me.g. Agent Chat UI\u001b[1m)\u001b[0m pointed at \u001b[4;94mhttp://localhost:2024\u001b[0m with \r\nassistant \u001b[32m'engineering_assistant'\u001b[0m\r\n"]
[91.764919, "o", "\u001b[1;32m$ factory surfaces show research_digest\u001b[0m\r\n"]
[93.374321, "o", "\u001b[1mMarket Research Digest\u001b[0m \u001b[1m(\u001b[0mresearch_digest\u001b[1m)\u001b[0m · identity: service \u001b[1m(\u001b[0munattended\u001b[1m)\u001b[0m\r\n"]
[93.374569, "o", "  slack    -> channel #market-research: run `python -m agent_factory.surfaces.slack research_digest` with \r\nSLACK_BOT_TOKEN/SLACK_APP_TOKEN; mentions call assistant \u001b[32m'research_digest'\u001b[0m at \u001b[4;94mhttp://localhost:2024\u001b[0m\r\n"]
[93.375031, "o", "  cron     -> schedule \u001b[32m'0 9 * * 1'\u001b[0m creates a run with input \u001b[1m{\u001b[0m\u001b[32m'question'\u001b[0m: \u001b[32m'Produce the weekly competitive \u001b[0m\r\n\u001b[32mdigest'\u001b[0m\u001b[1m}\u001b[0m; register with `factory surfaces register-crons research_digest`\r\n"]
