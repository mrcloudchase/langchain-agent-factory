[0.010446, "o", "\r\n\u001b[1;36m# Priya, platform lead: the org is defined as code\u001b[0m\r\n"]
[1.212801, "o", "\u001b[1;32m$\u001b[0m find org -type f | sort\r\n"]
[1.817419, "o", "org/models.yaml\r\norg/processes/regulated.yaml\r\norg/processes/standard.yaml\r\norg/teams.yaml\r\norg/templates/ai_research/examples.jsonl\r\norg/templates/ai_research/instructions.md\r\norg/templates/ai_research/steps.yaml\r\norg/templates/ai_research/template.yaml\r\norg/templates/coding_agent/examples.jsonl\r\norg/templates/coding_agent/instructions.md\r\norg/templates/coding_agent/template.yaml\r\norg/templates/support_agent/examples.jsonl\r\norg/templates/support_agent/instructions.md\r\norg/templates/support_agent/template.yaml\r\norg/tools.yaml\r\n"]
[3.619575, "o", "\r\n\u001b[1;36m# A template fixes tools, approvals, limits, evals and the path to production\u001b[0m\r\n"]
[4.821875, "o", "\u001b[1;32m$\u001b[0m sed -n '1,30p' org/templates/support_agent/template.yaml\r\n"]
[5.427146, "o", "key: support_agent\r\ntitle: Customer support agent\r\narchetype: agent\r\nsummary: >-\r\n  Triages helpdesk tickets: reads the ticket, customer, and order, applies the refund and\r\n  escalation policy, and drafts a reply for a human. Refunds always pause for a person.\r\nteams: [support]\r\nprocess: regulated\r\nmodel_tier: standard\r\nparameters:\r\n  - key: refund_policy\r\n    label: Refund policy, in plain language\r\n    default: >-\r\n      Duplicate charges are refunded in full. Annual plans are refundable within 30 days of\r\n      purchase; after that offer a prorated credit. Refunds over $500 go to tier 2.\r\n  - key: escalation_rule\r\n    label: When to escalate\r\n    default: >-\r\n      Escalate when the runbook says so, when a Team-plan customer hits a known issue, or when unsure.\r\ntools:\r\n  default: [lookup_ticket, lookup_customer, lookup_order, knowledge_search, draft_reply, escalate_ticket, issue_refund]\r\napprovals: [issue_refund]\r\nsurfaces:\r\n  default: [webhook, chat]\r\n  optional: [sdk]\r\nlimits: {model_calls: 10, tool_calls: 12}\r\nfilesystem: none\r\nevals:\r\n  thresholds: {tool_usage: 0.9, oversight: 1.0, policy_compliance: 1.0, answer_contains: 0.8}\r\n  regression_tolerance: 0.1\r\n"]
[7.230373, "o", "\r\n\u001b[1;36m# What builders can pick from\u001b[0m\r\n"]
[8.432762, "o", "\u001b[1;32m$\u001b[0m factory templates\r\n"]
[9.250381, "o", "┏━━━━━━━━━━━━━━━┳━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mtemplate     \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mtype    \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mteams                          \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mprocess  \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mpauses for a person\u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━╇━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━━━━━━━━━━━━━┩\r\n│ ai_research   │ workflow │ research, engineering, platform │ standard  │ -                   │\r\n│ coding_agent  │ agent    │ engineering                     │ standard  │ post_pr_comment     │\r\n│ support_agent │ agent    │ support                         │ regulated │ issue_refund        │\r\n└───────────────┴──────────┴─────────────────────────────────┴───────────┴─────────────────────┘\r\n"]
[11.096636, "o", "\u001b[1;32m$\u001b[0m factory tools\r\n"]
[11.897835, "o", "┏━━━━━━━━━━━━━━━━━━┳━━━━━━━━━━━━━┳━━━━━━━━━━━┳━━━━━━━━━┳━━━━━━━━━━━━━┓\r\n┃\u001b[1m \u001b[0m\u001b[1mtool            \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mteams      \u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1msensitive\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1macts as\u001b[0m\u001b[1m \u001b[0m┃\u001b[1m \u001b[0m\u001b[1mowner      \u001b[0m\u001b[1m \u001b[0m┃\r\n┡━━━━━━━━━━━━━━━━━━╇━━━━━━━━━━━━━╇━━━━━━━━━━━╇━━━━━━━━━╇━━━━━━━━━━━━━┩\r\n│ knowledge_search │ all         │           │ any     │ platform    │\r\n│ lookup_ticket    │ support     │           │ any     │ support     │\r\n│ lookup_customer  │ support     │           │ any     │ support     │\r\n│ lookup_order     │ support     │           │ any     │ support     │\r\n│ draft_reply      │ support     │           │ any     │ support     │\r\n│ escalate_ticket  │ support     │           │ any     │ support     │\r\n│ issue_refund     │ support     │ yes       │ any     │ support     │\r\n│ read_repo_file   │ engineering │           │ any     │ engineering │\r\n│ search_code      │ engineering │           │ any     │ engineering │\r\n│ read_ci_status   │ engineering │           │ any     │ engineering │\r\n│ post_pr_comment  │ engineering │ yes       │ user    │ engineering │\r\n│ paper_search     │ all         │           │ any     │ research    │\r\n│ hn_search        │ all         │           │ any     │ research    │\r\n│ package_releases │ all         │           │ any     │ research    │\r\n└──────────────────┴─────────────┴───────────┴─────────┴─────────────┘\r\n"]
[13.745751, "o", "\u001b[1;32m$\u001b[0m factory processes\r\n"]
[14.568452, "o", "\u001b[1mregulated\u001b[0m: dev -> staging \u001b[1m(\u001b[0mpolicy, evals\u001b[1m)\u001b[0m -> production \u001b[1m(\u001b[0mpolicy, evals, team approval, platform \r\napproval\u001b[1m)\u001b[0m\r\n  For agents that move money. Standard, plus a platform approval for production.\r\n"]
[14.568686, "o", "\u001b[1mstandard\u001b[0m: dev -> staging \u001b[1m(\u001b[0mpolicy, evals\u001b[1m)\u001b[0m -> production \u001b[1m(\u001b[0mpolicy, evals, team approval\u001b[1m)\u001b[0m\r\n  Policy and evals to reach staging; evals plus a team approver to reach production.\r\n"]
[16.418627, "o", "\r\n\u001b[1;36m# CI runs factory check on every pull request to org/\u001b[0m\r\n"]
[17.622141, "o", "\u001b[1;32m$\u001b[0m factory check\r\n"]
[18.503383, "o", "\u001b[1;36m3\u001b[0m templates · \u001b[1;36m14\u001b[0m tools · \u001b[1;36m2\u001b[0m processes · \u001b[1;36m4\u001b[0m teams · \u001b[1;36m8\u001b[0m people\r\n"]
[18.503599, "o", "\u001b[32morg is consistent\u001b[0m\r\n"]
[20.354623, "o", "\r\n\u001b[1;36m# A pull request that drops the approval on refunds...\u001b[0m\r\n"]
[21.564568, "o", "\u001b[1;32m$\u001b[0m diff org/templates/support_agent/template.yaml /tmp/pr-branch.7TLM/org/templates/support_agent/template.yaml || true\r\n"]
[22.168579, "o", "22c22\r\n< approvals: [issue_refund]\r\n---\r\n> approvals: []\r\n"]
[23.970917, "o", "\r\n\u001b[1;36m# ...fails the check, so it cannot merge\u001b[0m\r\n"]
[25.173347, "o", "\u001b[1;32m$\u001b[0m FACTORY_ROOT=/tmp/pr-branch.7TLM factory check || true\r\n"]
[26.000524, "o", "\u001b[1;36m3\u001b[0m templates · \u001b[1;36m14\u001b[0m tools · \u001b[1;36m2\u001b[0m processes · \u001b[1;36m4\u001b[0m teams · \u001b[1;36m8\u001b[0m people\r\n"]
[26.000862, "o", "  \u001b[31mproblem\u001b[0m template support_agent: sensitive tool \u001b[32m'issue_refund'\u001b[0m must be listed under approvals\r\n"]
[26.001139, "o", "\u001b[1;31m1\u001b[0m\u001b[31m \u001b[0m\u001b[1;31mproblem\u001b[0m\u001b[1;31m(\u001b[0m\u001b[31ms\u001b[0m\u001b[1;31m)\u001b[0m\r\n"]
